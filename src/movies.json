html{scroll-behavior:smooth}body{height:auto;min-height:100vh}.scene{position:relative;min-height:92vh;padding-bottom:90px}.scene .about{position:static;width:min(100%,480px);margin:26px auto 0;text-align:center}.scene .about p{font-size:16px}.scene .about h2{font-size:16px}.scroll-note{position:absolute;bottom:35px;left:50%;transform:translateX(-50%);color:var(--mist);font-size:14px;letter-spacing:.06em;text-decoration:none;white-space:nowrap}.scroll-note span{display:block;text-align:center;margin-top:5px}.movies-section{width:min(1340px,92%);margin:0 auto 140px;padding:38px 40px;border:1px solid var(--glass-edge);border-radius:24px;background:rgba(9,13,28,.86);backdrop-filter:blur(22px);scroll-margin-top:22px;box-shadow:0 25px 90px #0004}.movies-heading{display:flex;justify-content:space-between;align-items:center;gap:24px}.section-kicker{font-size:12px;letter-spacing:.24em;color:var(--dusk);margin:0 0 10px}.movies-heading h2{font-size:clamp(25px,3vw,36px);font-weight:500;line-height:1.3;margin:0}.movies-subtitle{font-size:16px;color:var(--mist);margin:12px 0 0}.collection-count{padding:9px 15px;border:1px solid var(--glass-edge);border-radius:30px;font-size:14px;white-space:nowrap}.movies-caption{display:flex;justify-content:space-between;gap:12px;color:var(--mist);font-size:14px;padding:25px 0 18px;border-bottom:1px solid var(--glass-edge);margin-bottom:24px}.movies-caption span:last-child{color:var(--lantern)}.movie-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:30px 20px}.movie-card{min-width:0}.movie-poster{display:block;position:relative;aspect-ratio:2/3;background:var(--night);border-radius:10px;overflow:hidden;border:1px solid #ffffff12}.movie-poster img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .35s var(--ease)}.movie-poster:hover img{transform:scale(1.045)}.movie-type{position:absolute;left:8px;top:8px;padding:3px 8px;font-size:12px;background:#0b0e1be6;border-radius:20px;color:var(--moon)}.movie-number{position:absolute;bottom:8px;left:8px;font-size:12px;padding:2px 7px;background:#090b14cc;border-radius:5px;color:#eee}.movie-card h3{font-size:15px;font-weight:500;line-height:1.45;margin:11px 0 6px}.movie-card h3 a{color:var(--moon);text-decoration:none}.movie-card h3 a:hover{color:var(--lantern)}.movie-meta{display:flex;justify-content:space-between;gap:8px;font-size:13px;color:var(--mist)}.movie-rating{color:var(--lantern);white-space:nowrap}.movie-note{font-size:12px;color:var(--dusk);line-height:1.5;margin:8px 0 0}.movie-sources{font-size:12px;line-height:1.7;color:var(--mist);border-top:1px solid var(--glass-edge);margin:35px 0 20px;padding-top:20px}.movie-sources a{color:var(--moon)}.back-home{color:var(--mist);font-size:14px;text-decoration:none}.chip{font-size:14px}.tagline{font-size:14px}@media(max-width:1050px){.movie-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.movies-section{padding:30px}}@media(max-width:650px){.scene{min-height:85vh;padding:50px 24px 90px}.movies-section{padding:25px 18px;border-radius:18px;width:94%}.movies-heading{display:block}.collection-count{display:inline-block;margin-top:16px}.movie-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:24px 14px}.movie-card h3{font-size:14px}.movies-caption{font-size:12px}.movies-subtitle{font-size:14px}.scene .about{max-width:300px}.scene .about p{font-size:14px}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.movie-poster img{transition:none}}

/* Original rounded social buttons */
.links .chip{font-size:12px;letter-spacing:.16em;padding:.75rem 1.15rem}
.links .chip:disabled{opacity:.65;cursor:default}
.links .chip:disabled:hover{transform:none;box-shadow:none}
